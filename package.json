{
  "name": "project-forecast",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@projectforecast/web",
    "dev:server": "turbo run dev --filter=@projectforecast/server",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
